---
/**
 * Inline SVG icons. Replaces the vendored Font Awesome package (29 MB, 2100+
 * files) with the handful of glyphs this site actually renders — no webfont
 * request, no icon-font FOUT, and they inherit `currentColor`.
 *
 * Paths are 24x24, stroke-based (Lucide-style geometry), except the LinkedIn
 * and GitHub brand marks which are filled.
 */
export type IconName =
  | "mail"
  | "phone"
  | "linkedin"
  | "github"
  | "globe"
  | "map-pin"
  | "printer"
  | "sun"
  | "moon"
  | "external-link";

interface Props {
  name: IconName;
  class?: string;
  /** Decorative by default; pass a label when the icon is the only content. */
  label?: string;
}

const { name, class: className = "size-4", label } = Astro.props;

const stroked: Partial<Record<IconName, string>> = {
  mail: `<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2.5 6.5 8.4 5.6a2 2 0 0 0 2.2 0l8.4-5.6"/>`,
  phone: `<path d="M14.5 2.5a7 7 0 0 1 7 7M14 6a3.5 3.5 0 0 1 3.5 3.5"/><path d="M8.6 3.5 10.4 7l-2.1 2a12 12 0 0 0 6.7 6.7l2-2.1 3.5 1.8v3.1a2 2 0 0 1-2.2 2A17 17 0 0 1 3.6 5.7a2 2 0 0 1 2-2.2Z"/>`,
  globe: `<circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19"/><path d="M12 2.5a15 15 0 0 1 0 19 15 15 0 0 1 0-19Z"/>`,
  "map-pin": `<path d="M20 10.5c0 5.5-8 12-8 12s-8-6.5-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10.5" r="2.8"/>`,
  printer: `<path d="M7 8.5V3h10v5.5"/><rect x="3" y="8.5" width="18" height="7.5" rx="2"/><path d="M7 14h10v7H7z"/>`,
  sun: `<circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.2M12 19.8V22M2 12h2.2M19.8 12H22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M19.1 4.9l-1.6 1.6M6.5 17.5l-1.6 1.6"/>`,
  moon: `<path d="M20.5 14.4A8.6 8.6 0 0 1 9.6 3.5a8.6 8.6 0 1 0 10.9 10.9Z"/>`,
  "external-link": `<path d="M14 4h6v6"/><path d="M20 4l-8.5 8.5"/><path d="M18 14.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4.5"/>`,
};

const filled: Partial<Record<IconName, string>> = {
  linkedin: `<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM2.4 21h5.2V9.7H2.4V21Zm7.9 0h5.2v-6.2c0-1.6.3-3.2 2.3-3.2 2 0 2 1.8 2 3.3V21H25V14c0-4-.9-6.6-5.1-6.6-2 0-3.4 1.1-4 2.2h-.1V9.7h-5V21h-.5Z" transform="translate(-0.5)"/>`,
  github: `<path d="M12 1.8a10.2 10.2 0 0 0-3.2 19.9c.5.1.7-.2.7-.5v-1.9c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.6 1 1.6 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.2.7-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c2-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7a3.9 3.9 0 0 1 1 2.7c0 3.9-2.4 4.7-4.6 4.9.4.3.7 1 .7 2v3c0 .3.2.6.8.5A10.2 10.2 0 0 0 12 1.8Z"/>`,
};

const isFilled = name in filled;
const body = isFilled ? filled[name] : stroked[name];
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill={isFilled ? "currentColor" : "none"}
  stroke={isFilled ? "none" : "currentColor"}
  stroke-width={isFilled ? undefined : 1.7}
  stroke-linecap={isFilled ? undefined : "round"}
  stroke-linejoin={isFilled ? undefined : "round"}
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
  set:html={body}
/>
