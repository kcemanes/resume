---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon, { type IconName } from "./Icon.astro";
import type { Resume } from "~/lib/schema";

interface Props {
  resume: Resume;
}

const { resume } = Astro.props;
const { profile, services } = resume;

/* Resolved from src/assets so Astro optimizes and hashes it (the source JPEG is
   ~800 KB; the emitted avatar is a fraction of that). */
const avatars = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const avatar = profile.avatar ? avatars[`/src/assets/${profile.avatar}`]?.default : undefined;

type Contact = {
  icon: IconName;
  /** Plain-text label shown only in print — a parser cannot read the SVG icon. */
  printLabel: string;
  label: string;
  href?: string;
};

const contacts: Contact[] = [];
if (profile.email)
  contacts.push({
    icon: "mail",
    printLabel: "Email",
    label: profile.email,
    href: `mailto:${profile.email}`,
  });
if (profile.phone)
  contacts.push({
    icon: "phone",
    printLabel: "Phone",
    label: profile.phone,
    href: `tel:${profile.phone.replace(/[^+\d]/g, "")}`,
  });
if (profile.linkedin)
  contacts.push({
    icon: "linkedin",
    printLabel: "LinkedIn",
    label: `in/${profile.linkedin}`,
    href: `https://www.linkedin.com/in/${profile.linkedin}`,
  });
if (profile.github)
  contacts.push({
    icon: "github",
    printLabel: "GitHub",
    label: profile.github,
    href: `https://github.com/${profile.github}`,
  });
if (profile.website)
  contacts.push({
    icon: "globe",
    printLabel: "Website",
    label: profile.website.replace(/^https?:\/\//, "").replace(/\/$/, ""),
    href: profile.website,
  });
if (profile.location)
  contacts.push({ icon: "map-pin", printLabel: "Location", label: profile.location });
if (profile.citizenship)
  contacts.push({ icon: "globe", printLabel: "Citizenship", label: profile.citizenship });

const headingClass =
  "mb-3 text-[0.7rem] font-bold tracking-[0.16em] text-accent-200 uppercase dark:text-accent-300 print:mb-1 print:text-[8pt] print:tracking-normal";
---

{
  /*
  On screen this is the left column. In print the whole sheet collapses to a
  single column (see the `print:` utilities on the wrapper in index.astro) and
  this becomes a full-width header band: name, tagline, then contact and
  services as compact inline rows.

  Education deliberately lives in the main column, not here — a resume parser
  reads the PDF's linear text, and keeping every section in one flow means DOM
  order is the order the parser sees. No CSS reordering is involved.
*/
}
<aside
  class="sidebar bg-accent-600 px-7 py-9 text-accent-50 md:w-[19.5rem] md:shrink-0 dark:bg-accent-900 print:w-auto print:px-0 print:pt-0 print:pb-3"
>
  <div class="mb-8 text-center print:mb-2 print:text-left">
    {
      avatar && (
        <Image
          src={avatar}
          alt={`Portrait of ${profile.name}`}
          width={132}
          height={132}
          quality={82}
          loading="eager"
          class="mx-auto mb-4 size-[132px] rounded-full border-[3px] border-white/25 object-cover shadow-lg print:hidden"
        />
      )
    }
    <h1
      class="text-[1.55rem] leading-tight font-semibold tracking-tight text-white print:text-[17pt]"
    >
      {profile.name}
    </h1>
    <p class="mt-1 text-[0.9rem] text-accent-50 print:mt-0 print:text-[10.5pt] print:text-black">
      {profile.tagline}
    </p>
  </div>

  <!-- Contact -->
  <div class="avoid-break mb-8 print:mb-2">
    <h2 class={`${headingClass} print:hidden`}>Contact</h2>
    <ul
      class="space-y-2 text-[0.85rem] print:flex print:flex-wrap print:gap-x-4 print:gap-y-0 print:space-y-0 print:text-[8.8pt]"
    >
      {
        contacts.map((c) => (
          <li class="flex items-start gap-2.5 print:block">
            <Icon name={c.icon} class="mt-0.5 size-[15px] shrink-0 opacity-80 print:hidden" />
            <span class="hidden font-semibold print:inline">{`${c.printLabel}: `}</span>
            {c.href ? (
              <a
                href={c.href}
                class="break-all underline decoration-white/30 underline-offset-2 transition-colors hover:decoration-white print:no-underline"
              >
                {c.label}
              </a>
            ) : (
              <span class="break-words">{c.label}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Services -->
  {
    services.length > 0 && (
      <div class="avoid-break print:mb-0">
        <h2 class={headingClass}>Services</h2>
        <ul class="space-y-1.5 text-[0.85rem] print:flex print:flex-wrap print:gap-x-3 print:space-y-0 print:text-[8.8pt]">
          {services.map((s) => (
            <li class="flex items-start gap-2.5 print:block print:not-last:after:content-['_•']">
              <span
                class="mt-[0.45rem] size-1.5 shrink-0 rounded-full bg-accent-300 print:hidden"
                aria-hidden="true"
              />
              <span>{s}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</aside>
