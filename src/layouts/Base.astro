---
import "~/styles/global.css";
import type { Resume } from "~/lib/schema";

interface Props {
  resume: Resume;
  title?: string;
  description?: string;
}

const { resume, title, description } = Astro.props;
const { profile, summary } = resume;

const pageTitle = title ?? `${profile.name} — ${profile.tagline}`;
const pageDescription = description ?? summary.replace(/\s+/g, " ").trim().slice(0, 300);
/* Normalize so the canonical URL always matches what the sitemap advertises
   and what the host actually serves — never a bare `/index.html`. */
const canonicalPath = Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, "");
const canonical = new URL(canonicalPath, Astro.site ?? "https://resume.kcemanes.com");

/* schema.org Person, so search engines and recruiter tooling can read the
   resume as structured data rather than scraping the markup. */
const sameAs = [
  profile.linkedin && `https://www.linkedin.com/in/${profile.linkedin}`,
  profile.github && `https://github.com/${profile.github}`,
  profile.website,
].filter(Boolean);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.tagline,
  description: pageDescription,
  email: `mailto:${profile.email}`,
  url: canonical.href,
  ...(sameAs.length > 0 && { sameAs }),
  ...(profile.location && {
    address: { "@type": "PostalAddress", addressLocality: profile.location },
  }),
  alumniOf: resume.education.map((e) => ({
    "@type": "EducationalOrganization",
    name: e.institution,
  })),
  worksFor: resume.experience.slice(0, 1).map((e) => ({
    "@type": "Organization",
    name: e.company.split(",")[0],
  })),
  knowsAbout: resume.skills.flatMap((g) => g.items),
  hasCredential: resume.certifications.map((c) => ({
    "@type": "EducationalOccupationalCredential",
    name: c.name,
    recognizedBy: { "@type": "Organization", name: c.organization },
    ...(c.credentialId && { identifier: c.credentialId }),
  })),
};
---

<!doctype html>
<html lang="en" class="scroll-pt-8">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- No prefers-color-scheme variant: the page defaults to light regardless
         of the OS setting, so the browser chrome should too. -->
    <meta name="theme-color" content="#11659a" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="en_CA" />
    <meta property="profile:first_name" content={profile.name.split(" ")[0]} />
    <meta property="profile:last_name" content={profile.name.split(" ").slice(1).join(" ")} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <!-- Resolve the theme before first paint so there is no light/dark flash.
         Light is the default for everyone: the OS preference is deliberately
         ignored, because the page is a resume and the light theme is the one
         that matches the printed PDF. Dark is opt-in via the toolbar toggle,
         and that choice is what gets remembered. -->
    <script is:inline>
      (() => {
        try {
          if (localStorage.getItem("theme") === "dark") {
            document.documentElement.classList.add("dark");
          }
        } catch {
          /* storage blocked — fall through to the light default */
        }
      })();
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="no-print sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-30 focus:rounded-md focus:bg-accent-600 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
